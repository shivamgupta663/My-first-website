<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ICSE Class 10 - Premium Practice Arena</title>
    <style>
        :root {
            --bg-color: #0b1329;
            --card-bg: #1c2541;
            --text-main: #f8fafc;
            --text-sub: #8da9c4;
            --accent-blue: #38bdf8;
            --border-color: rgba(255, 255, 255, 0.05);
        }

        body {
            font-family: 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 600px;
            margin: 30px auto;
        }

        .back-link {
            color: var(--text-sub);
            text-decoration: none;
            font-size: 0.9rem;
            display: inline-block;
            margin-bottom: 20px;
        }

        .header {
            text-align: center;
            margin-bottom: 40px;
        }

        .header h1 {
            font-size: 2.2rem;
            background: linear-gradient(135deg, #38bdf8, #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin: 10px 0;
        }

        .subject-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            margin-bottom: 16px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        }

        .subject-header {
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .subject-title {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 1.2rem;
            font-weight: 700;
        }

        .chapter-count {
            background: rgba(56, 189, 248, 0.15);
            color: var(--accent-blue);
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .chapters-list {
            padding: 0 20px 20px 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .chapter-item {
            background: #111a36;
            border: 1px solid rgba(255,255,255,0.03);
            border-radius: 10px;
            padding: 14px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s;
        }

        .chapter-item:hover {
            border-color: var(--accent-blue);
            background: #152247;
        }

        .chapter-name {
            font-size: 0.95rem;
            font-weight: 600;
        }

        .start-btn {
            background: linear-gradient(135deg, #38bdf8, #0284c7);
            color: #fff;
            text-decoration: none;
            padding: 8px 14px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 700;
        }
    </style>
</head>
<body>

    <div class="container">
        <a href="index.html" class="back-link">← Back to Dashboard</a>
        
        <div class="header">
            <h1>✨ Practice Arena</h1>
            <p style="color: var(--text-sub); margin: 0;">Select any chapter to start your dynamic preparation</p>
        </div>

        <div class="subject-card">
            <div class="subject-header">
                <div class="subject-title">
                    <span>📐 Mathematics</span>
                    <span class="chapter-count">All Board Chapters Live</span>
                </div>
            </div>
            
            <div class="chapters-list">
                <div class="chapter-item">
                    <div class="chapter-name">1. Goods and Services Tax (GST)</div>
                    <a href="practice.html?ch=gst" class="start-btn">Practice →</a>
                </div>

                <div class="chapter-item">
                    <div class="chapter-name">2. Banking (Recurring Deposits)</div>
                    <a href="practice.html?ch=banking" class="start-btn">Practice →</a>
                </div>

                <div class="chapter-item">
                    <div class="chapter-name">3. Linear Inequations</div>
                    <a href="practice.html?ch=lineariq" class="start-btn">Practice →</a>
                </div>

                <div class="chapter-item">
                    <div class="chapter-name">4. Quadratic Equations</div>
                    <a href="practice.html?ch=quadratic" class="start-btn">Practice →</a>
                </div>

                <div class="chapter-item">
                    <div class="chapter-name">5. Ratio and Proportion</div>
                    <a href="practice.html?ch=ratio" class="start-btn">Practice →</a>
                </div>

                <div class="chapter-item">
                    <div class="chapter-name">6. Matrices</div>
                    <a href="practice.html?ch=matrices" class="start-btn">Practice →</a>
                </div>

                <div class="chapter-item">
                    <div class="chapter-name">7. Arithmetic Progression (A.P.)</div>
                    <a href="practice.html?ch=ap" class="start-btn">Practice →</a>
                </div>

                <div class="chapter-item">
                    <div class="chapter-name">8. Reflection & Coordinate Geometry</div>
                    <a href="practice.html?ch=coordinate" class="start-btn">Practice →</a>
                </div>

                <div class="chapter-item">
                    <div class="chapter-name">9. Trigonometry Mastery</div>
                    <a href="practice.html?ch=trigo" class="start-btn">Practice →</a>
                </div>

                <div class="chapter-item">
                    <div class="chapter-name">10. Statistics & Probability</div>
                    <a href="practice.html?ch=stats" class="start-btn">Practice →</a>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
